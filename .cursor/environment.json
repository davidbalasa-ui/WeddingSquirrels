{
  "name": "WeddingSquirrels",
  "user": "ubuntu",
  "install": "bash scripts/cloud-agent-install.sh",
  "start": "bash scripts/cloud-agent-start.sh",
  "terminals": [
    {
      "name": "dev",
      "command": "bash scripts/cloud-agent-start.sh && npm run dev",
      "description": "Next.js dev server on http://localhost:3000 (ensures local Postgres is up first)"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
