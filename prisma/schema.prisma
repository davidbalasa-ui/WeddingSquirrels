generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id          Int      @id @default(1)
  weddingDate DateTime
  timezone    String   @default("America/Detroit")
  coupleNames String   @default("David & Haley")
  updatedAt   DateTime @updatedAt
}

model Person {
  id            String         @id
  name          String
  sortOrder     Int            @default(0)
  assignees     TaskAssignee[]
  budgets       BudgetItem[]   @relation("BudgetOwner")
  budgetsPaid   BudgetItem[]   @relation("BudgetPayer")
  shoppingItems ShoppingItem[]
  pinAccounts   PinAccount[]
}

model Task {
  id              String         @id @default(cuid())
  title           String
  summary         String?
  planNotes       String?
  status          String         @default("todo")
  dueDate         DateTime?
  amountNeeded    Float?
  amountSpent     Float          @default(0)
  helpText        String?
  sourceRow       Int?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  budgetItemId    String?
  budgetItem      BudgetItem?    @relation(fields: [budgetItemId], references: [id])
  timelineBlockId String?
  timelineBlock   TimelineBlock? @relation(fields: [timelineBlockId], references: [id])
  parentId        String?
  parent          Task?          @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Task[]         @relation("TaskTree")
  assignees       TaskAssignee[]
  shoppingItems   ShoppingItem[]
  shares          TaskShare[]
  requests        Request[]
  orgKey          String?
  escalatedAt     DateTime?
  escalatedBy     String?

  @@index([status, dueDate])
  @@index([parentId])
  @@unique([orgKey])
}

model TaskAssignee {
  taskId   String
  personId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
  @@index([personId])
}

model BudgetItem {
  id         String            @id @default(cuid())
  name       String
  price      Float
  amountPaid Float             @default(0)
  payByDate  DateTime?
  ownerId    String?
  owner      Person?           @relation("BudgetOwner", fields: [ownerId], references: [id])
  paidById   String?
  paidBy     Person?           @relation("BudgetPayer", fields: [paidById], references: [id])
  sortOrder  Int               @default(0)
  note       String?
  tasks      Task[]
  shares     BudgetItemShare[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model BudgetItemShare {
  budgetItemId String
  pinAccountId String
  budgetItem   BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  pinAccount   PinAccount @relation(fields: [pinAccountId], references: [id], onDelete: Cascade)

  @@id([budgetItemId, pinAccountId])
  @@index([pinAccountId])
}

model TaskShare {
  taskId       String
  pinAccountId String
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pinAccount   PinAccount @relation(fields: [pinAccountId], references: [id], onDelete: Cascade)

  @@id([taskId, pinAccountId])
  @@index([pinAccountId])
}

model TimelineBlock {
  id           String  @id @default(cuid())
  startAt      String
  endAt        String?
  notes        String
  sortOrder    Int     @default(0)
  startMinutes Int?
  endMinutes   Int?
  dayOffset    Int     @default(0)
  tasks        Task[]
}

model Guest {
  id                 String  @id @default(cuid())
  nameLine1          String
  nameLine2          String?
  street             String?
  city               String?
  state              String?
  zip                String?
  person1TableNumber Int?
  person1TableSpot   String?
  person2TableNumber Int?
  person2TableSpot   String?
  sortOrder          Int     @default(0)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  startDate DateTime
  endDate   DateTime
  eventKey  String?  @unique
  color     String   @default("#2f5d50")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model PinAccount {
  id                 String            @id @default(cuid())
  name               String
  pinHash            String
  isMaster           Boolean           @default(false)
  canSeeTasks        Boolean           @default(true)
  canSeeBudget       Boolean           @default(false)
  canSeeGuests       Boolean           @default(false)
  canSeeTimeline     Boolean           @default(false)
  canManageAccounts  Boolean           @default(false)
  canSeeShop         Boolean           @default(true)
  canSeeCalendar     Boolean           @default(true)
  canSeePeople       Boolean           @default(true)
  canSeeRequests     Boolean           @default(true)
  canSeeStay         Boolean           @default(true)
  canSeeDinner       Boolean           @default(false)
  canEditBudget      Boolean           @default(false)
  canEditTimeline    Boolean           @default(false)
  linkedPersonId     String?
  linkedPerson       Person?           @relation(fields: [linkedPersonId], references: [id])
  assigneeFilterJson String?
  budgetShares       BudgetItemShare[]
  taskShares         TaskShare[]
  requestsSent       Request[]         @relation("RequestsSent")
  requestsReceived   Request[]         @relation("RequestsReceived")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ShoppingItem {
  id         String   @id @default(cuid())
  name       String
  quantity   String?
  note       String?
  purchased  Boolean  @default(false)
  ownerId    String?
  owner      Person?  @relation(fields: [ownerId], references: [id])
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([purchased, sortOrder])
  @@index([ownerId])
  @@index([taskId])
}

model StaySlot {
  id         String   @id
  sectionId  String
  label      String
  occupant   String   @default("")
  optional   Boolean  @default(false)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

model StayBathNote {
  id        String   @id @default(cuid())
  sectionId String
  note      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

model MealSettings {
  id        Int      @id @default(1)
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model MealOption {
  id        String   @id @default(cuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealGuest {
  id        String   @id
  sectionId String
  name      String
  optionId  String?
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

model Request {
  id                 String     @id @default(cuid())
  title              String
  note               String?
  status             String     @default("open")
  senderAccountId    String
  senderAccount      PinAccount @relation("RequestsSent", fields: [senderAccountId], references: [id], onDelete: Cascade)
  recipientAccountId String
  recipientAccount   PinAccount @relation("RequestsReceived", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  taskId             String?
  task               Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  readAt             DateTime?
  completedAt        DateTime?
  declinedAt         DateTime?
  declineNote        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([recipientAccountId, status, readAt])
  @@index([senderAccountId, status])
  @@index([taskId])
}
