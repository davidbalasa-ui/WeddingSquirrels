generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id           Int      @id @default(1)
  weddingDate  DateTime
  timezone     String   @default("America/Detroit")
  coupleNames  String   @default("David & Haley")
  updatedAt    DateTime @updatedAt
}

model Person {
  id        String         @id
  name      String
  sortOrder Int            @default(0)
  assignees TaskAssignee[]
  budgets   BudgetItem[]   @relation("BudgetOwner")
}

model Task {
  id             String         @id @default(cuid())
  title          String
  status         String         @default("todo") // todo | doing | done | blocked
  dueDate        DateTime?
  helpText       String?
  sourceRow      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  completedAt    DateTime?
  budgetItemId   String?
  budgetItem     BudgetItem?    @relation(fields: [budgetItemId], references: [id])
  timelineBlockId String?
  timelineBlock  TimelineBlock? @relation(fields: [timelineBlockId], references: [id])
  assignees      TaskAssignee[]

  @@index([status, dueDate])
}

model TaskAssignee {
  taskId   String
  personId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
  @@index([personId])
}

model BudgetItem {
  id          String    @id @default(cuid())
  name        String
  price       Float
  amountPaid  Float     @default(0)
  payByDate   DateTime?
  ownerId     String?
  owner       Person?   @relation("BudgetOwner", fields: [ownerId], references: [id])
  sortOrder   Int       @default(0)
  note        String?
  tasks       Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model TimelineBlock {
  id        String    @id @default(cuid())
  startAt   String
  endAt     String?
  notes     String
  sortOrder Int       @default(0)
  tasks     Task[]
}

model Guest {
  id        String @id @default(cuid())
  nameLine1 String
  nameLine2 String?
  street    String?
  city      String?
  state     String?
  zip       String?
  sortOrder Int    @default(0)
}

model PinAccount {
  id                 String   @id @default(cuid())
  name               String
  pinHash            String
  isMaster           Boolean  @default(false)
  canSeeTasks        Boolean  @default(true)
  canSeeBudget       Boolean  @default(false)
  canSeeGuests       Boolean  @default(false)
  canSeeTimeline     Boolean  @default(false)
  canManageAccounts  Boolean  @default(false)
  /// JSON string array of Person.id values; null/empty = all people (for masters)
  assigneeFilterJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
