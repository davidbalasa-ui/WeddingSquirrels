generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id          Int      @id @default(1)
  weddingDate DateTime
  timezone    String   @default("America/Detroit")
  coupleNames String   @default("David & Haley")
  updatedAt   DateTime @updatedAt
}

model Person {
  id            String         @id
  name          String
  sortOrder     Int            @default(0)
  assignees     TaskAssignee[]
  budgets       BudgetItem[]   @relation("BudgetOwner")
  shoppingItems ShoppingItem[]
  pinAccounts   PinAccount[]
}

/// Decision workspace: either a top-level package or a nested step.
model Task {
  id              String         @id @default(cuid())
  title           String
  /// Short “what is this” explanation for the package/step
  summary         String?
  /// Writable plan: what is being decided / done
  planNotes       String?
  status          String         @default("todo") // todo | doing | done | blocked
  dueDate         DateTime?
  amountNeeded    Float?
  amountSpent     Float          @default(0)
  helpText        String?
  sourceRow       Int?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?
  budgetItemId    String?
  budgetItem      BudgetItem?    @relation(fields: [budgetItemId], references: [id])
  timelineBlockId String?
  timelineBlock   TimelineBlock? @relation(fields: [timelineBlockId], references: [id])
  parentId        String?
  parent          Task?          @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Task[]         @relation("TaskTree")
  assignees       TaskAssignee[]
  shoppingItems   ShoppingItem[]
  requests        Request[]
  /// Special shared org cards: "week_before" | "day_before" (null = normal decision)
  orgKey          String?
  /// When set, task is pinned to the top as priority
  escalatedAt     DateTime?
  escalatedBy     String?

  @@index([status, dueDate])
  @@index([parentId])
  @@unique([orgKey])
}

model TaskAssignee {
  taskId   String
  personId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
  @@index([personId])
}

model BudgetItem {
  id         String    @id @default(cuid())
  name       String
  price      Float
  amountPaid Float     @default(0)
  payByDate  DateTime?
  ownerId    String?
  owner      Person?   @relation("BudgetOwner", fields: [ownerId], references: [id])
  sortOrder  Int       @default(0)
  note       String?
  tasks      Task[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model TimelineBlock {
  id        String  @id @default(cuid())
  startAt   String
  endAt     String?
  notes     String
  sortOrder Int     @default(0)
  tasks     Task[]
}

model Guest {
  id                 String  @id @default(cuid())
  nameLine1          String
  nameLine2          String?
  street             String?
  city               String?
  state              String?
  zip                String?
  person1TableNumber Int?
  person1TableSpot   String?
  person2TableNumber Int?
  person2TableSpot   String?
  sortOrder          Int     @default(0)
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  notes     String?
  startDate DateTime
  endDate   DateTime
  /// Stable key for seeded events: bachelorette | bachelor | wedding
  eventKey  String?  @unique
  color     String   @default("#2f5d50")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model PinAccount {
  id                 String   @id @default(cuid())
  name               String
  pinHash            String
  isMaster           Boolean  @default(false)
  canSeeTasks        Boolean  @default(true)
  canSeeBudget       Boolean  @default(false)
  canSeeGuests       Boolean  @default(false)
  canSeeTimeline     Boolean  @default(false)
  canSeeShop         Boolean  @default(true)
  canSeeCalendar     Boolean  @default(true)
  canSeePeople       Boolean  @default(true)
  canSeeRequests     Boolean  @default(true)
  canEditBudget      Boolean  @default(false)
  canEditTimeline    Boolean  @default(false)
  canManageAccounts  Boolean  @default(false)
  /// JSON string array of Person.id values; null/empty = all tasks (not “none”)
  assigneeFilterJson String?
  linkedPersonId     String?
  linkedPerson       Person?  @relation(fields: [linkedPersonId], references: [id])
  requestsSent       Request[] @relation("RequestsSent")
  requestsReceived   Request[] @relation("RequestsReceived")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// In-app ask between PinAccounts (login identities), not Persons.
model Request {
  id                  String      @id @default(cuid())
  title               String
  note                String?
  status              String      @default("open") // open | done | declined
  senderAccountId     String
  recipientAccountId  String
  taskId              String?
  readAt              DateTime?
  completedAt         DateTime?
  declinedAt          DateTime?
  declineNote         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  senderAccount       PinAccount  @relation("RequestsSent", fields: [senderAccountId], references: [id], onDelete: Cascade)
  recipientAccount    PinAccount  @relation("RequestsReceived", fields: [recipientAccountId], references: [id], onDelete: Cascade)
  task                Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([recipientAccountId, status, readAt])
  @@index([senderAccountId, status])
  @@index([taskId])
}

model ShoppingItem {
  id         String   @id @default(cuid())
  name       String
  quantity   String?
  note       String?
  purchased  Boolean  @default(false)
  ownerId    String?
  owner      Person?  @relation(fields: [ownerId], references: [id])
  taskId     String?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([purchased, sortOrder])
  @@index([ownerId])
  @@index([taskId])
}
